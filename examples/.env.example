# Allos MCP container configuration

# Container image version
ALLOS_VERSION=0.2.1

# Existing Allos database directory
ALLOS_DATA_DIR=/srv/allos/data

# Profile accessible through MCP
ALLOS_PROFILE_ID=1

# Directory containing token, server.crt and server.key
ALLOS_SECRETS_DIR=/srv/allos-mcp/secrets

# Container user and group
ALLOS_UID=10001
ALLOS_GID=10001

# Host address for HTTPS
ALLOS_BIND_ADDRESS=127.0.0.1
